{
  "redirects": [
    {
      "source": "/resources",
      "destination": "/resources/",
      "permanent": true
    },
    {
      "source": "/all-guides",
      "destination": "/all-guides/",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/calculators/dog-feeding-calculator",
      "destination": "/calculators/dog-feeding-calculator/",
      "permanent": true
    },
    {
      "source": "/calculators/enrichment-finder",
      "destination": "/calculators/enrichment-finder/",
      "permanent": true
    },
    {
      "source": "/resources/:slug",
      "destination": "/resources/:slug/",
      "permanent": true
    },
    {
      "source": "/choosing-the-right-slow-feeder",
      "destination": "/resources/choosing-the-right-slow-feeder/",
      "permanent": true
    },
    {
      "source": "/choosing-the-right-slow-feeder/",
      "destination": "/resources/choosing-the-right-slow-feeder/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/results/:token",
      "destination": "/index.html"
    },
    {
      "source": "/results/:token/",
      "destination": "/index.html"
    }
  ]
}
